# ============================================================
# ATTENDIFY — Production Environment Configuration Template
# Copy this file to .env and configure for your deployment
# NEVER commit the actual .env file with secrets to version control
# ============================================================

# ------------------------------------------------------------
# FRONTEND CONFIGURATION (GitHub Pages / Static Client)
# ------------------------------------------------------------
# URL of your deployed Node.js backend service (e.g. Render / Railway / Fly.io / VPS).
# When running on GitHub Pages (https://chillingbing648-sketch.github.io/Attendify/),
# set this to your cloud backend URL.
# Can also be set in-app via Settings -> Backend API Connection, or via ?api=URL parameter.
# Leave empty when developing locally on localhost (defaults to same-origin).
ATTENDIFY_API_BASE_URL=https://your-attendify-api.onrender.com

# ------------------------------------------------------------
# BACKEND CONFIGURATION (Node.js Server: Render / Railway / VPS)
# ------------------------------------------------------------
# Network & Server Port (Render automatically supplies PORT=10000)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration
# Local SQLite file path (default: ./attendify.db) or ':memory:' for transient tests
DATABASE_PATH=./attendify.db

# Optional Managed PostgreSQL URL (e.g., Supabase / Neon / AWS RDS)
# DATABASE_URL=postgresql://attendify_user:strong_password@host:5432/attendify_prod

# Security & CORS Allowlist
# Comma-separated list of trusted origins permitted to make cross-origin requests
# MUST include your GitHub Pages origin without trailing slash:
ALLOWED_ORIGINS=https://chillingbing648-sketch.github.io,https://harshportfolio404.netlify.app,http://localhost:3000,http://127.0.0.1:3000

# Faculty Authentication Session Secret (Generate a strong 32+ char random string)
FACULTY_SESSION_SECRET=change_me_to_a_cryptographically_secure_random_string_in_production

# Student Session Expiry Window (in hours, default: 24)
STUDENT_SESSION_EXPIRY_HOURS=24
